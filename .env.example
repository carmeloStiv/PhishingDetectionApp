# Copy to .env (never commit it) or set these in your hosting provider's secret store.
# Everything is optional: with no keys the service still runs with rules, the ML model,
# the bundled popularity list, the OpenPhish community feed, RDAP domain age and page retrieval.

# --- Threat intelligence (server-side only; never sent to the browser) ---
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
URLHAUS_AUTH_KEY=
ENABLE_OPENPHISH=true
# OPENPHISH_FEED_URL=https://raw.githubusercontent.com/openphish/public_feed/refs/heads/main/feed.txt
# OPENPHISH_REFRESH_SECONDS=21600

# --- Network analysis ---
ENABLE_LIVE_FETCH=true          # fetch the submitted page (SSRF-hardened; see docs/SECURITY.md)
ENABLE_DOMAIN_AGE=true          # RDAP registration-date lookups
# RDAP_BASE_URL=https://rdap.org/domain/
# FETCH_TIMEOUT_SECONDS=8
# FETCH_MAX_BYTES=750000
# FETCH_MAX_REDIRECTS=5
# INTEL_TIMEOUT_SECONDS=6

# --- Service ---
RATE_LIMIT_PER_MINUTE=20        # analyses per client address per minute (0 disables)
TRUST_PROXY_HEADERS=false       # set true ONLY behind a reverse proxy that sets X-Forwarded-For
MAX_TEXT_CHARS=50000
MAX_LINKS_PER_MESSAGE=5
DATA_DIR=var                    # feedback database location
FEEDBACK_RETENTION_DAYS=180
